<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SparkLead @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="apps"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plugins" description="SparkLead for Ableton Live, Cubase, Bitwig, Reaper, Studio One and FL Studio.">
        <pkg-ref id="com.sparkaudio.sparklead.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plugins" description="SparkLead for Logic Pro, GarageBand and Ableton Live.">
        <pkg-ref id="com.sparkaudio.sparklead.au"/>
    </choice>
    <choice id="apps" title="Standalone apps" description="SparkLead as an app you can run without a DAW.">
        <pkg-ref id="com.sparkaudio.sparklead.apps"/>
    </choice>
    <pkg-ref id="com.sparkaudio.sparklead.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.sparkaudio.sparklead.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.sparkaudio.sparklead.apps" version="@VERSION@" onConclusion="none">apps.pkg</pkg-ref>
</installer-gui-script>
